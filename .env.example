ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
# Set true only behind working HTTPS; keep false for localhost or LAN HTTP.
SESSION_COOKIE_SECURE=false
#WEB-01 CTF challenge flag
WEB01_FLAG=
# Optional LAN mode: explicit local IP of this laptop. Never use 0.0.0.0.
# Default (unset) keeps the platform on 127.0.0.1 only.
#NGINX_BIND=192.168.1.100
