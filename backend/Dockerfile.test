FROM python:3.12-slim
WORKDIR /code
COPY backend/requirements.txt backend/requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt
COPY backend/app ./backend/app
COPY backend/tests ./backend/tests
COPY labs/web-01/server.py ./labs/web-01/server.py
COPY frontend ./frontend
COPY scripts/ctf_smoke.py scripts/check_resource_integration.py scripts/check_static_files.py scripts/generate_crypto_01.py scripts/check_crypto_01_resource.py scripts/check_crypto_01_flow.py scripts/auth_load.py ./scripts/
COPY files/crypto-01/challenge.txt ./files/crypto-01/challenge.txt
COPY .github/workflows/ci.yml ./.github/workflows/ci.yml
COPY ruff.toml ./ruff.toml
RUN find backend scripts labs -type f -name '*.py' -exec chmod 0644 {} + \
 && chmod 0755 scripts/auth_load.py
ENV PYTHONPATH=/code/backend \
    PYTHONDONTWRITEBYTECODE=1
CMD ["python", "-m", "pytest", "backend/tests", "-q"]
